{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "devcontainer", "custom.regex"],
  "schedule": ["on saturday"],
  "automerge": true,
  "platformAutomerge": true,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Do not rewrite runs-on. ubuntu-26.04-arm is a chosen runner, not a dependency.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)ansible/workstation/roles/debian/vars/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s+\\w+: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
