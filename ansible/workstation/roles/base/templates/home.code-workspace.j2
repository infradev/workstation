{%- set darwin_terminal -%}
,

  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "{{ '/opt/homebrew' if ansible_facts['architecture'] == 'arm64' else '/usr/local' }}/bin/bash"
    }
  }
{%- endset -%}
{
  "folders": [
    {
      "path": "."
    },
    {
      "path": "projects"
    }
  ],
  "settings": {{ ((vscode.settings | trim)[:-1] | trim ~ (darwin_terminal if ansible_facts['os_family'] == 'Darwin' else '') ~ '\n}') | indent(2) }}
}
