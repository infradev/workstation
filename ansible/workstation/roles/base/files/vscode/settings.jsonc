{
  // Editor settings
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "all",
  "editor.rulers": [
    80,
    100,
    120
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },

  // Files settings
  "files.autoSave": "afterDelay",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/*.tfstate": true,
    "**/*.tfstate.*": true,
    "**/.terraform": true,
    ".terraform.lock.hcl": true
  },

  // Git workflow
  "git.autofetch": "all",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,

  // Git repository detection
  // Open git only when a workspace folder is itself a repository.
  // Do not scan nested folders. Skip every folder named .devcontainer.
  "git.autoRepositoryDetection": false,
  "git.openRepositoryInParentFolders": "never",
  "git.repositoryScanMaxDepth": 0,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".devcontainer"
  ],

  // Detection modes (uncomment one; false is active above)
  // true: workspace folders, nested folders, and parents of open files
  // "subFolders": nested folders of workspace folders
  // "openEditors": parent folders of open files
  // "git.autoRepositoryDetection": true,
  // "git.autoRepositoryDetection": "subFolders",
  // "git.autoRepositoryDetection": "openEditors",

  // Parent folder repositories (never is active above)
  // "always": open git roots above the workspace
  // "prompt": ask first
  // "git.openRepositoryInParentFolders": "always",
  // "git.openRepositoryInParentFolders": "prompt",

  // Nested scan depth (0 is active above)
  // 1: one level of child folders
  // -1: unlimited depth
  // "git.repositoryScanMaxDepth": 1,
  // "git.repositoryScanMaxDepth": -1,

  // Extra scan paths. Relative to a workspace folder. Absolute paths are ignored.
  // Used only when autoRepositoryDetection is true or "subFolders".
  // "git.scanRepositories": ["projects/example"],

  // Repositories to ignore (relative or absolute paths)
  // "git.ignoredRepositories": [],

  // Extra folder names to skip during nested scan
  // "git.repositoryScanIgnoredFolders": ["node_modules", ".devcontainer", ".creds"],

  // Submodules and worktrees
  // "git.detectSubmodules": true,
  // "git.detectSubmodulesLimit": 10,
  // "git.ignoreSubmodules": false,
  // "git.detectWorktrees": true,
  // "git.detectWorktreesLimit": 10,

  // Source Control view
  // Tree is folders for files inside a repo. Path sorts those files and the repo list.
  "scm.defaultViewMode": "tree",
  "scm.defaultViewSortKey": "path",
  "scm.repositories.sortOrder": "path",

  // Source Control repository list
  // "scm.alwaysShowRepositories": true,
  // "scm.repositories.visible": 0,
  // "scm.repositories.sortOrder": "discovery time",
  // "scm.repositories.sortOrder": "name",
  // "scm.repositories.selectionMode": "multiple",
  // "scm.providerCountBadge": "hidden",
  // "scm.alwaysShowActions": false,
  // "scm.countBadge": "all",
  // "scm.autoReveal": true,
  // "scm.defaultViewMode": "list",
  // "scm.defaultViewSortKey": "name",
  // "scm.defaultViewSortKey": "status",

  // Terminal settings
  "terminal.integrated.scrollback": 100000,
  "terminal.integrated.defaultProfile.linux": "bash",

  // UI settings
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tree.indent": 15,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.colorCustomizations": {
    "tree.indentGuidesStroke": "#05ef3c"
  },
  "window.autoDetectColorScheme": false,

  // Spell checker settings
  "cSpell.enabled": true,
  "cSpell.words": [
    "aquasecurity",
    "azurerm",
    "checkov",
    "devcontainer",
    "gcloud",
    "hadolint",
    "helmfile",
    "infracost",
    "k9s",
    "krew",
    "kubeconfig",
    "kubectx",
    "kubens",
    "nvm",
    "pipx",
    "postgresql",
    "sops",
    "tenv",
    "terragrunt",
    "terramate",
    "terrascan",
    "tflint",
    "tfsec",
    "tofu",
    "trivy"
  ],

  // Terraform settings
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "terraform.languageServer": {
    "enabled": true,
    "args": ["serve"]
  },
  "terraform.experimentalFeatures.validateOnSave": true,

  // YAML settings
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Markdown settings
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.formatOnSave": true
  }
}
