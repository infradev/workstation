{
  "name": "${localWorkspaceFolderBasename}",

  // Build args and sibling services live in compose.yaml. Version pins
  // are in .env, which Compose loads from this directory. kind is installed
  // by the kind feature below; it creates clusters through Docker-in-Docker,
  // not as a Compose service.
  "dockerComposeFile": "compose.yaml",
  "service": "workstation",
  "workspaceFolder": "/workspaces/project",
  "shutdownAction": "stopCompose",
  "overrideCommand": true,
  // The .devcontainer/.creds/* directories are pre-created and committed
  // (gitignored contents, tracked skeleton via .gitkeep) rather than mkdir'd
  // here - see "Dev Container credentials" in README.md.
  // Git doesn't preserve directory permission bits across a clone though, so
  // the ssh dir's 700 still needs fixing up at init time.
  "initializeCommand": "chmod 700 ${localWorkspaceFolder}/.devcontainer/.creds/ssh",

  "postCreateCommand": "post-create",
  "postStartCommand": "post-start",
  "remoteUser": "alex",

  // Shared extensions and settings live in
  // ansible/workstation/roles/base/files/vscode/ and are installed by
  // post-create. Only the client-side extensions the macOS role also adds
  // are listed here.
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh"
      ]
    }
  },

  // Docker-in-Docker is the one feature Ansible cannot replace: it starts
  // dockerd inside this container. kubectl, Helm, helmfile, kind, sops, git,
  // gh, Node, Claude Code, and the apt clients are installed by the playbook.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },

  // Environment variables
  "containerEnv": {
    "TF_PLUGIN_CACHE_DIR": "/home/alex/.terraform.d/plugin-cache",
    "CLAUDE_CONFIG_DIR": "/home/alex/.claude",

    // tenv resolves Terraform/Terragrunt/Terramate/OpenTofu per project and
    // downloads any version a repo pins but the image does not carry.
    "TENV_ROOT": "/home/alex/.local/share/tenv",
    "TENV_AUTO_INSTALL": "true",

    // Authenticates tenv's own GitHub API lookups (Terragrunt/Terramate/
    // OpenTofu version resolution) at runtime; unset just falls back to
    // unauthenticated, rate-limited lookups.
    "TENV_GITHUB_TOKEN": "${localEnv:TENV_GITHUB_TOKEN}"
  }
}
