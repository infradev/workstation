{
  "name": "Terraform Development Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "VARIANT": "ubuntu26.04",
      "ARGOCD_VERSION": "3.5.3",
      "AWS_IAM_AUTHENTICATOR_VERSION": "0.7.20",
      "CHECKOV_VERSION": "3.3.23",
      "GLAB_VERSION": "1.121.0",
      "HADOLINT_VERSION": "2.15.1",
      "INFRACOST_VERSION": "0.10.46",
      "K9S_VERSION": "0.51.0",
      "KREW_VERSION": "0.5.0",
      "KUBECTX_VERSION": "0.11.0",
      "NVM_VERSION": "0.40.8",
      "RTK_VERSION": "0.51.0",
      "STERN_VERSION": "1.34.0",
      "TENV_VERSION": "4.15.1",
      "TERRAFORM_DOCS_VERSION": "0.24.0",
      "TERRAFORM_VERSION": "1.16.5",
      "TERRAGRUNT_VERSION": "1.1.6",
      "TERRAMATE_VERSION": "0.17.3",
      "TERRASCAN_VERSION": "1.19.9",
      "TERRATEST_VERSION": "1.0.1",
      "TFLINT_AWS_RULESET_VERSION": "0.49.0",
      "TFLINT_AZURE_RULESET_VERSION": "0.32.0",
      "TFLINT_GCP_RULESET_VERSION": "0.40.0",
      "TFLINT_VERSION": "0.64.0",
      "TFSEC_VERSION": "1.28.14",
      "TRIVY_VERSION": "0.75.0",
      "UV_VERSION": "0.12.23",
      "YQ_VERSION": "4.54.1",
      "GIT_USER_NAME": "Alexandre Souza",
      "GIT_USER_EMAIL": "alexandre@infradev.com.br"
    }
  },
  // The .devcontainer/.creds/* directories are pre-created and committed
  // (gitignored contents, tracked skeleton via .gitkeep) rather than mkdir'd
  // here - see "Devcontainer: user and credential isolation" in README.md.
  // Git doesn't preserve directory permission bits across a clone though, so
  // the ssh dir's 700 still needs fixing up at init time.
  "initializeCommand": "chmod 700 ${localWorkspaceFolder}/.devcontainer/.creds/ssh",

  "postStartCommand": "post-start",
  "remoteUser": "alex",

  // docker-in-docker requires the container to run in privileged mode.
  // --name/--hostname derive from the project directory name instead of the
  // generated vsc-<folder>-<hash>-uid one, so the container is predictable to
  // address and the shell prompt inside it matches the project.
  "runArgs": [
    "--privileged",
    "--name", "${localWorkspaceFolderBasename}",
    "--hostname", "${localWorkspaceFolderBasename}"
  ],

  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created
      "extensions": [
        "amazonwebservices.aws-toolkit-vscode",
        "anthropic.claude-code",
        "davidanson.vscode-markdownlint",
        "dbcode.dbcode",
        "donjayamanne.githistory",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "hashicorp.hcl",
        "hashicorp.terraform",
        "mhutchie.git-graph",
        "mineiros.terramate",
        "moshfeu.compare-folders",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh",
        "opentofu.vscode-opentofu",
        "pkief.material-icon-theme",
        "qcz.text-power-tools",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck",
        "yzhang.markdown-all-in-one"
      ],

      // Set *default* container specific settings.json values on container create
      "settings": {
        // Editor settings
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.renderWhitespace": "all",
        "editor.rulers": [
          80,
          100,
          120
        ],
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },

        // Files settings
        "files.autoSave": "afterDelay",
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/*.tfstate": true,
          "**/*.tfstate.*": true,
          "**/.terraform": true,
          ".terraform.lock.hcl": true
        },

        // Git settings
        "git.autofetch": "all",
        "git.enableSmartCommit": true,
        "git.confirmSync": false,

        // Terminal settings
        "terminal.integrated.scrollback": 100000,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },

        // UI settings
        "workbench.iconTheme": "material-icon-theme",
        "workbench.tree.indent": 15,
        "workbench.tree.renderIndentGuides": "always",
        "workbench.colorCustomizations": {
          "tree.indentGuidesStroke": "#05ef3c"
        },
        "window.autoDetectColorScheme": false,

        // Spell checker settings
        "cSpell.enabled": true,
        "cSpell.words": [
          "aquasecurity",
          "azurerm",
          "checkov",
          "devcontainer",
          "gcloud",
          "hadolint",
          "helmfile",
          "infracost",
          "k9s",
          "krew",
          "kubeconfig",
          "kubectx",
          "kubens",
          "nvm",
          "postgresql",
          "pipx",
          "sops",
          "tenv",
          "terragrunt",
          "terramate",
          "terrascan",
          "tflint",
          "tfsec",
          "tofu",
          "trivy"
        ],

        // Terraform settings
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },
        "terraform.languageServer": {
          "enabled": true,
          "args": []
        },
        "terraform.experimentalFeatures.validateOnSave": true,

        // YAML settings
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.formatOnSave": true,
          "editor.tabSize": 2
        },

        // Markdown settings
        "[markdown]": {
          "editor.defaultFormatter": "yzhang.markdown-all-in-one",
          "editor.formatOnSave": true
        }
      }
    }
  },

  // Mount project-scoped credential dirs (see initializeCommand above) and
  // caching volumes. Each project/client gets its own isolated set of cloud
  // and Claude Code logins instead of sharing the host's global ~/.aws etc.
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.creds/aws,target=/home/alex/.aws,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.creds/azure,target=/home/alex/.azure,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.creds/gcloud,target=/home/alex/.config/gcloud,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.creds/ssh,target=/home/alex/.ssh,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.creds/glab-cli,target=/home/alex/.config/glab-cli,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/.creds/kube,target=/home/alex/.kube,type=bind,consistency=cached",
    // Holds credentials.tfrc.json from "terraform login" (Terraform Cloud).
    // terraform login replaces that file via rename, which a single-file bind
    // mount rejects, so the whole directory is mounted. The plugin-cache volume
    // below is nested inside it (a shared, non-sensitive binary cache, so it
    // stays a plain named volume rather than project-scoped).
    "source=${localWorkspaceFolder}/.devcontainer/.creds/terraform.d,target=/home/alex/.terraform.d,type=bind,consistency=cached",
    "source=terraform-cache,target=/home/alex/.terraform.d/plugin-cache,type=volume",

    // Claude Code state (OAuth login, settings/permissions, plugins, skills,
    // sessions, project trust - .claude.json lives inside this same dir, see
    // initializeCommand) - project-scoped, so each project has its own
    // separate Claude Code login instead of sharing the host's.
    "source=${localWorkspaceFolder}/.devcontainer/.creds/claude,target=/home/alex/.claude,type=bind,consistency=cached"
  ],

  // Use 'forwardPorts' to make a list of ports inside the container available locally
  // "forwardPorts": [],

  // Features to add to the dev container
  "features": {
    // Claude Code needs a system-wide Node at feature-install time; the nvm
    // install in common-utils.sh is per-user and not visible to it.
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": false
    },
    // Ubuntu 26.04 (resolute) has no moby-cli packages; use upstream Docker CE,
    // which does publish a resolute suite for amd64 and arm64.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "minikube": "none"
    },
    "ghcr.io/devcontainers-extra/features/helmfile:1": {},
    "ghcr.io/devcontainers-extra/features/kind:1": {},
    "ghcr.io/devcontainers-extra/features/sops:1": {},
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "mysql-client,postgresql-client,pv,direnv"
    }
  },

  // Environment variables
  "containerEnv": {
    "TF_PLUGIN_CACHE_DIR": "/home/alex/.terraform.d/plugin-cache",
    "CLAUDE_CONFIG_DIR": "/home/alex/.claude",

    // tenv resolves Terraform/Terragrunt/Terramate/OpenTofu per project and
    // downloads any version a repo pins but the image does not carry.
    "TENV_ROOT": "/usr/local/share/tenv",
    "TENV_AUTO_INSTALL": "true",

    // Authenticates tenv's own GitHub API lookups (Terragrunt/Terramate/
    // OpenTofu version resolution) at runtime; unset just falls back to
    // unauthenticated, rate-limited lookups.
    "TENV_GITHUB_TOKEN": "${localEnv:TENV_GITHUB_TOKEN}"
  }
}
